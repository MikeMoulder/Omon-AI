# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# spike scratch
.spike-keys.json
.env.local

# Binance MCP OAuth token. Authorises the REAL Binance account (canTrade: true),
# and the process rewrites this file when it renews, so it must never be tracked.
.mcp-token.json

# ...but the template must ship: it is how a judge sets the project up.
!.env.example

# The durable ledger, caches and beat counter (src/lib/store.ts). Runtime state:
# it is the record of what this deployment actually did, not source. Never
# commit it, and never delete it to "clean up" — the P&L is derived from it.
/data/
