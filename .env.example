# ── Omon ─────────────────────────────────────────────────────────────────────
# One switch every seam reads. fixture = recorded data, live = real calls.
DEMO_MODE=fixture

# ── Paid endpoints (x402) ────────────────────────────────────────────────────
# Which rail the 402 routes settle on.
#   testnet      = public x402 facilitator, Base Sepolia. Permissionless, works today.
#   b402         = Binance OnchainPay B402 on BSC. Needs merchant credentials below.
#   b402-preview = the B402 mapping is published and inspectable at /api/b402 —
#                  including the exact BSC challenge this service would issue —
#                  while payments still settle on the public rail. Needs no
#                  credentials. This is the mode for demoing B402 before merchant
#                  onboarding clears; nothing on it claims B402 is settling.
X402_RAIL=testnet

# Wallet that RECEIVES payments (yours). Same address works on both rails.
PAY_TO_ADDRESS=0x...

# testnet rail
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
X402_PRICE=0.01

# b402 rail — issued by Binance during merchant onboarding.
# B402_PRIVATE_KEY is an RSA request-signing key, NOT an EVM private key.
B402_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY=
B402_NETWORK=eip155:56
B402_TOKEN_ADDRESS=
B402_TOKEN_NAME=
B402_TOKEN_VERSION=1
B402_TOKEN_DECIMALS=18
# eip3009 (no ERC-20 approval needed) or permit2-exact (one-time Permit2 approval).
# Permit2 Upto is intentionally unsupported by @bnb-chain/b402.
B402_TRANSFER_METHOD=eip3009

# ── Buyer side (scripts/pay.mjs only — never used by the server) ─────────────
# Throwaway testnet key funded with Base Sepolia USDC. Do not reuse a real key.
BUYER_PRIVATE_KEY=
RESOURCE_SERVER_URL=http://localhost:3000

# ── Binance MCP — the Agent OS read path ─────────────────────────────────────
# Every market read goes here first: prices, the candles the strategy computes
# on, and account state. Order WRITES never do — see the Spot Demo Mode block
# below for why. If MCP is unavailable the reads fall back to REST and say so
# on GET /api/agent-os; nothing breaks silently.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
MCP_TIMEOUT_MS=10000

# HOW TO CONNECT (once — the browser step does not repeat per run):
#   1. Deploy/serve Omon on a public origin and set PUBLIC_BASE_URL to it.
#   2. PUBLIC_BASE_URL=https://your-host npx tsx scripts/mcp-auth.ts
#   3. Approve in the browser. The token is written to .mcp-token.json.
#   4. Verify: npx tsx scripts/mcp-smoke.ts
#
# Binance MCP is OAuth-only. Exchange API keys do NOT work on it (verified:
# X-MBX-APIKEY returns 401), and the server advertises only the
# authorization_code grant, so there is no unattended way to mint a first token.
# PUBLIC_BASE_URL must be publicly reachable because Binance fetches
# /.well-known/oauth-client server-side to identify the client.
PUBLIC_BASE_URL=

# Where the token is stored. A FILE, not an env var, so the long-running process
# can rewrite it when it renews — an env var cannot be updated from inside the
# process that needs it. Never commit this file: it authorises the REAL Binance
# account (canTrade: true). Already in .gitignore.
BINANCE_MCP_TOKEN_FILE=.mcp-token.json

# Escape hatch only: a token pasted here is used when no token file exists.
# Fine for a quick test, wrong for the VPS — it cannot be auto-renewed.
BINANCE_MCP_ACCESS_TOKEN=

# DEMO_MODE=fixture disables MCP along with everything else. Set this to 1 to
# exercise the real MCP rail while the rest of the app stays on fixtures.
MCP_IN_FIXTURE_MODE=

# Loopback port the one-time auth flow listens on for the OAuth redirect. Must
# match the port published in /.well-known/oauth-client.
MCP_AUTH_PORT=8788

# ── LLM (Intel Agent + Signal Agent) ─────────────────────────────────────────
# Google Gemini, free tier. Key from https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty and every LLM call falls back to fixtures.
# Free tier is Flash-only. Flash-Lite is the default: measured 3.6s vs 14.7s for
# gemini-3.5-flash on the same prompt, and it has the larger daily quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000

# ── Binance SPOT Demo Mode (order execution) ─────────────────────────────────
# Keys: https://demo.binance.com/en/my/settings/api-management (real Binance login).
# Demo Mode mirrors the live exchange — same features, same filters, realistic
# order books — and spends nothing real. NOT the same as Spot Testnet
# (testnet.binance.vision), which has an independent order book and its own keys.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_SPOT_BASE_PATH=https://demo-api.binance.com

# Where PRICES are read from. Left unset it matches the execution host, which is
# accurate: testnet spot tracks mainnet within a cent on BTCUSDT (verified
# 2026-09-05). Set to https://data-api.binance.vision only if a host gets blocked.
BINANCE_PRICE_BASE_PATH=
EXCHANGE_TIMEOUT_MS=10000

# ── Budget layer (src/lib/budget.ts) ─────────────────────────────────────────
# The agent's leash. Plain code, checked before every order. The model never
# sees these numbers and cannot raise them.
# Keep BUDGET_MAX_TRADE_USD low — the demo's BLOCKED beat is a trade above it.
BUDGET_MAX_TRADE_USD=25
BUDGET_DAILY_TRADE_USD=100
BUDGET_ALLOWED_SYMBOLS=BNBUSDT,BTCUSDT,ETHUSDT
BUDGET_REQUIRE_APPROVAL_ABOVE_USD=25

# ── FUTURES (USDⓈ-M perpetuals) ───────────────────────────────────────────────
#
# OFF by default, and deliberately opt-in rather than opt-out. Futures is the
# one venue here that can lose more than it puts in, and a deployment that gets
# leverage by accident is a deployment nobody chose to leverage.
#
# What it buys you: the ability to act on a BEARISH read. src/lib/strategy.ts
# has always detected short breakouts and a spot account cannot trade one, so
# half the analysis engine was computed and discarded. This is the rail that
# makes it live.
FUTURES_ENABLED=0

# Separate host from spot. Defaults to Binance's USDⓈ-M futures testnet, which
# is free, needs no funding, and runs the real matching engine. Point it at the
# futures demo host instead if you have demo.binance.com futures keys.
BINANCE_FUTURES_BASE_PATH=https://testnet.binancefuture.com

# Futures key pair. Falls back to BINANCE_API_KEY / BINANCE_SECRET_KEY when
# blank, which works on a single-account setup; a host that rejects the spot key
# says so plainly rather than failing silently.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_SECRET_KEY=

# Hard leverage ceiling, enforced in src/lib/futures.ts AND src/lib/budget.ts.
# Two places on purpose: one stops a bad env var reaching Binance, the other
# stops a model-proposed number getting that far. Clamped to 20 whatever is set.
FUTURES_MAX_LEVERAGE=3

# Futures rejects smaller notionals with -4164.
FUTURES_MIN_NOTIONAL_USD=5
#
# NOTE ON THE BUDGET: BUDGET_MAX_TRADE_USD and BUDGET_DAILY_TRADE_USD are
# checked against NOTIONAL on both venues, not against margin. $20 at 3x posts
# about $6.67 and carries $20 of exposure, and it is the $20 that counts. That
# way "$100 a day" means one thing on both venues and leverage cannot quietly
# multiply the cap. Closing a position is exempt from the daily cap entirely:
# an agent that cannot exit because it hit its own spending limit is in a worse
# place than one that never traded.

# --- News + intel cache -------------------------------------------------------
# RSS feeds the Intel Agent collects from. Comma separated, no key required.
# Default: cointelegraph + coindesk. Verified returning 200 on 2026-09-05.
NEWS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss
NEWS_TIMEOUT_MS=10000

# How long analysed intel counts as fresh. Past this it is still served, but
# flagged `fresh:false` with its age so a buyer can judge it.
INTEL_TTL_MS=300000

# Headlines pulled per refresh, before dedupe.
INTEL_FETCH_LIMIT=10

# Quota guard, not a tuning knob. The Gemini free tier is ~1,000 requests/day;
# a 5 minute refresh is 288 refreshes/day, so an unbounded batch could burn the
# allowance before lunch and lock the account out on recording day.
INTEL_MAX_NEW=3

# --- Model keys ---------------------------------------------------------------
# One key per agent so a busy news cycle cannot starve the trading agent. Both
# fall back to GEMINI_API_KEY, so a single key still works.
#
# WARNING: this only buys separate quota if the two keys come from separate
# Google Cloud PROJECTS. Gemini free-tier limits are per project, so two keys
# minted in one project share one allowance and the split does nothing.
GEMINI_INTEL_API_KEY=
GEMINI_SIGNAL_API_KEY=

# Origin published in /.well-known/x402. Leave empty — the manifest reads the
# request origin, which is right on localhost and on the deployed domain. Set it
# only if a proxy rewrites the host. Do NOT reuse RESOURCE_SERVER_URL here: that
# is the buyer script's variable and it pins the manifest to localhost:3000.
PUBLIC_BASE_URL=

# --- Strategy -----------------------------------------------------------------
# Candle interval the technical layer reads. 1h by default, not the 4h the
# ren-ai paper log was measured on: 4h breakouts fire about once a week, which is
# too rare to show in a 2:15 demo. Same rules, a clock the demo can reach.
CANDLE_INTERVAL=1h
