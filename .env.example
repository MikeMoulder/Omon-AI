# ── Omon ─────────────────────────────────────────────────────────────────────
# One switch every seam reads. fixture = recorded data, live = real calls.
DEMO_MODE=fixture

# ── Paid endpoints (x402) ────────────────────────────────────────────────────
# Which rail the 402 routes settle on.
#   testnet = public x402 facilitator, Base Sepolia. Permissionless, works today.
#   b402    = Binance OnchainPay B402 on BSC. Needs merchant credentials.
X402_RAIL=testnet

# Wallet that RECEIVES payments (yours). Same address works on both rails.
PAY_TO_ADDRESS=0x...

# testnet rail
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
X402_PRICE=0.01

# b402 rail — issued by Binance during merchant onboarding.
# B402_PRIVATE_KEY is an RSA request-signing key, NOT an EVM private key.
B402_BASE_URL=
B402_CLIENT_ID=
B402_ACCESS_TOKEN=
B402_PRIVATE_KEY=
B402_NETWORK=eip155:56
B402_TOKEN_ADDRESS=
B402_TOKEN_NAME=
B402_TOKEN_VERSION=1
B402_TOKEN_DECIMALS=18

# ── Buyer side (scripts/pay.mjs only — never used by the server) ─────────────
# Throwaway testnet key funded with Base Sepolia USDC. Do not reuse a real key.
BUYER_PRIVATE_KEY=
RESOURCE_SERVER_URL=http://localhost:3000

# ── Binance MCP (spike 1) ────────────────────────────────────────────────────
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# ── LLM (Intel Agent + Signal Agent) ─────────────────────────────────────────
# Google Gemini, free tier. Key from https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty and every LLM call falls back to fixtures.
# Free tier is Flash-only. Flash-Lite is the default: measured 3.6s vs 14.7s for
# gemini-3.5-flash on the same prompt, and it has the larger daily quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000

# ── Binance SPOT Demo Mode (order execution) ─────────────────────────────────
# Keys: https://demo.binance.com/en/my/settings/api-management (real Binance login).
# Demo Mode mirrors the live exchange — same features, same filters, realistic
# order books — and spends nothing real. NOT the same as Spot Testnet
# (testnet.binance.vision), which has an independent order book and its own keys.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_SPOT_BASE_PATH=https://demo-api.binance.com

# Where PRICES are read from. Left unset it matches the execution host, which is
# accurate: testnet spot tracks mainnet within a cent on BTCUSDT (verified
# 2026-09-05). Set to https://data-api.binance.vision only if a host gets blocked.
BINANCE_PRICE_BASE_PATH=
EXCHANGE_TIMEOUT_MS=10000

# ── Budget layer (src/lib/budget.ts) ─────────────────────────────────────────
# The agent's leash. Plain code, checked before every order. The model never
# sees these numbers and cannot raise them.
# Keep BUDGET_MAX_TRADE_USD low — the demo's BLOCKED beat is a trade above it.
BUDGET_MAX_TRADE_USD=25
BUDGET_DAILY_TRADE_USD=100
BUDGET_ALLOWED_SYMBOLS=BNBUSDT,BTCUSDT,ETHUSDT
BUDGET_REQUIRE_APPROVAL_ABOVE_USD=25

# --- News + intel cache -------------------------------------------------------
# RSS feeds the Intel Agent collects from. Comma separated, no key required.
# Default: cointelegraph + coindesk. Verified returning 200 on 2026-09-05.
NEWS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss
NEWS_TIMEOUT_MS=10000

# How long analysed intel counts as fresh. Past this it is still served, but
# flagged `fresh:false` with its age so a buyer can judge it.
INTEL_TTL_MS=300000

# Headlines pulled per refresh, before dedupe.
INTEL_FETCH_LIMIT=10

# Quota guard, not a tuning knob. The Gemini free tier is ~1,000 requests/day;
# a 5 minute refresh is 288 refreshes/day, so an unbounded batch could burn the
# allowance before lunch and lock the account out on recording day.
INTEL_MAX_NEW=3

# --- Model keys ---------------------------------------------------------------
# One key per agent so a busy news cycle cannot starve the trading agent. Both
# fall back to GEMINI_API_KEY, so a single key still works.
#
# WARNING: this only buys separate quota if the two keys come from separate
# Google Cloud PROJECTS. Gemini free-tier limits are per project, so two keys
# minted in one project share one allowance and the split does nothing.
GEMINI_INTEL_API_KEY=
GEMINI_SIGNAL_API_KEY=
